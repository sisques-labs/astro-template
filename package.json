{
  "name": "sisqueslabs/astro-template",
  "version": "0.1.0",
  "description": "Minimal Astro starter template to speed up new project setup.",
  "author": "Sisques Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/sisques-labs/astro-template.git"
  },
  "homepage": "https://github.com/sisques-labs/astro-template",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro}\"",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "astro": "astro",
    "prepare": "node -e \"if(process.env.HUSKY!=='0')require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "astro": "7.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
